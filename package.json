{
	"name": "c4dm-studios",
	"version": "1.0.0",
	"homepage": ".",
	"private": true,
	"type": "module",
	"dependencies": {
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-markdown": "^10.1.0",
		"react-router": "^8.4.0",
		"rehype-raw": "^7.0.0",
		"sass-embedded": "^1.104.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@eslint-react/eslint-plugin": "^5.19.1",
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.20.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/react-router": "^5.1.20",
		"@vitejs/plugin-react": "^6.1.1",
		"eslint": "^10.10.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"gh-pages": "^6.3.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.7",
		"stylelint": "^17.15.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vite-plugin-compression2": "^2.5.3"
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": true,
		"fsevents@2.3.3": true
	},
	"scripts": {
		"build": "tsc && vite build",
		"deploy": "gh-pages -d dist",
		"dev": "vite --host",
		"format": "biome format --write ; prettier --write ./**/*.md ./**/*.scss",
		"preview": "vite preview",
		"predeploy": "npm run build",
		"test": "tsc ; biome lint ; eslint . ; stylelint **/*.scss"
	},
	"prettier": {
		"arrowParens": "always",
		"bracketSpacing": true,
		"bracketSameLine": false,
		"endOfLine": "lf",
		"htmlWhitespaceSensitivity": "strict",
		"jsxSingleQuote": true,
		"printWidth": 125,
		"quoteProps": "as-needed",
		"semi": false,
		"singleQuote": true,
		"tabWidth": 4,
		"trailingComma": "all",
		"useTabs": true
	},
	"stylelint": {
		"extends": "stylelint-config-standard-scss",
		"rules": {
			"property-no-vendor-prefix": null,
			"scss/double-slash-comment-empty-line-before": null
		}
	}
}
